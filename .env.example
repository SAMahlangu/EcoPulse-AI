# Frontend (copy to frontend/.env.local)
VITE_API_URL=http://localhost:8000/api/v1
# Future Supabase Auth client configuration (public anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (copy to backend/.env)
CORS_ORIGINS=http://localhost:5173
ECOPULSE_DB_PATH=./ecopulse.sqlite3
# Keep true only for an isolated local SQLite demo. Production should use Supabase/Postgres.
ECOPULSE_LOCAL_DEMO=true
# Optional. Set only if you subscribe to Open-Meteo's commercial API.
# Leave blank to use the no-key free API for non-commercial evaluation.
OPEN_METEO_API_KEY=
# Configure Supabase connection/JWT validation before any production deployment.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
DATABASE_URL=
# Server-only. Never add this value to frontend/.env.local.
SUPABASE_SERVICE_ROLE_KEY=
APP_PUBLIC_URL=http://localhost:5173
ECOPULSE_INCIDENT_MODEL=

# Localhost-only resident registration without email confirmation. Keep false when deployed.
ECOPULSE_LOCAL_PASSWORD_SIGNUP=false
