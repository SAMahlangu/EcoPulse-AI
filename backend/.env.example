# Server configuration. Keep the populated .env file out of Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Optional legacy-key/JWT fallbacks. Prefer current publishable/secret keys.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
ECOPULSE_DB_PATH=./ecopulse.sqlite3
ECOPULSE_LOCAL_DEMO=false
ECOPULSE_LOCAL_PASSWORD_SIGNUP=false
# Application-only DNS fallback; no system network settings are changed.
ECOPULSE_DNS_FALLBACK=false

# Optional provider integrations. These keys stay on the server.
OPEN_METEO_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
YOLO_MODEL_PATH=models/best.pt
YOLO_MIN_CONFIDENCE=0.25
YOLO_CONFIRM_CONFIDENCE=0.40
YOLO_HIGH_CONFIDENCE=0.70
YOLO_DEVICE=cpu

# Resend takes priority when configured; otherwise SMTP is used.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TIMEOUT_SECONDS=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
